# .env.example
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/airdb
OPENAQ_API_KEY=your_api_key_here

# ETL defaults
ETL_HOURS_BACK=24
ETL_MAX_LOCATIONS=8
ETL_MAX_SENSORS=20
ETL_PER_SENSOR=4
OPENAQ_RADIUS_M=20000
OPENAQ_PAGE_LIMIT=200
OPENAQ_MAX_PAGES=5
OPENAQ_MIN_DELAY_SEC=0.6
